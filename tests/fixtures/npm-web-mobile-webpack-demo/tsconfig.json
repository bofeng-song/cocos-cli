{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "useDefineForClassFields": false
    },
    "include": [
        "globals.d.ts",
        "main.ts",
        "scripts/**/*.ts"
    ]
}
